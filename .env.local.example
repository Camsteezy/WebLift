# Copy to .env.local and fill in. .env.local is gitignored.

# Local Postgres. Homebrew creates a superuser named after your macOS
# account rather than "postgres", so use your own username here:
#   brew install postgresql@17 && brew services start postgresql@17
#   createdb weblift
DATABASE_URL=postgres://YOUR_USERNAME@localhost:5432/weblift

# Hosted (Neon / Vercel Postgres / Supabase) — note sslmode:
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
